# Local development secrets for `wrangler` / the Cloudflare Vite plugin.
# Copy this file to `.dev.vars` (git-ignored) and fill in real values.
# The marketing site runs WITHOUT these; lead capture requires Supabase.

SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Only needed to enable online payments (COD works without it).
# Generate: openssl rand -base64 32
PAYMENTS_ENC_KEY=""
ENVIRONMENT="development"
