# ---------------------------------------------------------------------------
# Bhama Vision Grocery Cloud — environment reference
# ---------------------------------------------------------------------------
# This file documents every variable the app reads. It is validated at runtime
# by app/lib/env.server.ts (zod). Copy the SECRET values into `.dev.vars` for
# local development (see .dev.vars.example) and set them as Cloudflare secrets
# in production with `wrangler secret put <NAME>`.
#
# PUBLIC_* values are non-secret and are configured in wrangler.json `vars`
# (and surfaced to the browser). Secrets below must NEVER be committed.
# ---------------------------------------------------------------------------

# --- Public runtime config (safe to expose; set in wrangler.json `vars`) ---
PUBLIC_APP_NAME="Bhama Vision Grocery Cloud"
# Apex domain used to compose merchant subdomains, e.g. sharma.<domain>.
PUBLIC_APP_DOMAIN="localhost:5173"
PUBLIC_SUPPORT_EMAIL="hello@bhamavision.example"
# WhatsApp number in international format WITHOUT "+", e.g. 919999999999.
PUBLIC_WHATSAPP_NUMBER=""
# Optional marketing/analytics IDs (loaded only after visitor consent).
PUBLIC_META_PIXEL_ID=""
PUBLIC_GA_MEASUREMENT_ID=""
PUBLIC_GOOGLE_ADS_CONVERSION_ID=""

# --- Supabase (SECRET — set via `wrangler secret put` / .dev.vars) ---
# Create a project at https://supabase.com, then Project Settings > API.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
# Service role bypasses RLS. Server-only. Used by trusted endpoints (e.g. the
# validated, rate-limited lead capture). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# development | preview | production
ENVIRONMENT="development"
